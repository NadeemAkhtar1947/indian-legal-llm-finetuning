#!/bin/bash
#PBS -N llama_h100
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=23:00:00
#PBS -j oe
#PBS -o /Data2/ds_24901720/Nadeem/llama3_training/logs/training_h100_output.log

echo "=== JOB STARTED ==="
date
echo "Working directory: $(pwd)"

cd /Data2/ds_24901720/Nadeem/llama3_training
echo "Changed to: $(pwd)"

export CUDA_VISIBLE_DEVICES=MIG-4d38d5cf-c802-5308-80b8-251f3cec7480
echo "GPU: $CUDA_VISIBLE_DEVICES"

echo "Activating conda..."
source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate llama3_legal
echo "Conda activated: $CONDA_DEFAULT_ENV"

echo "Python version: $(python --version)"
echo "Starting training..."
date

python3 scripts/train_single_h100_fast.py

echo "=== JOB FINISHED ==="
date
